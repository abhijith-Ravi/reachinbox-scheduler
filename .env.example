# Local development values only. Change every password before deployment.
MYSQL_DATABASE=reachinbox_dev
MYSQL_USER=reachinbox_dev
MYSQL_PASSWORD=local_app_password_change_me
MYSQL_ROOT_PASSWORD=local_root_password_change_me
MYSQL_PORT=13306
REDIS_PORT=6379
DATABASE_URL=mysql://reachinbox_dev:local_app_password_change_me@127.0.0.1:13306/reachinbox_dev
REDIS_HOST=127.0.0.1
API_PORT=3000
# Exact browser frontend origin; update for the deployed frontend.
FRONTEND_ORIGIN=http://localhost:5173
DEFAULT_SENDER_EMAIL=hello@example.com
DEFAULT_SENDER_NAME=ReachInbox Development
# Google Identity Services Web OAuth client. Same client ID is configured in frontend/.env.
GOOGLE_CLIENT_ID=
# Generate a private cookie-signing key with: openssl rand -hex 32
GOOGLE_SESSION_SECRET=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
WORKER_CONCURRENCY=5
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=5000
EMAIL_PROCESSING_STALE_MS=900000
EMAIL_MIN_SEND_DELAY_MS=1000
SENDER_MAX_EMAILS_PER_HOUR=100
# Optional Slack OAuth v2; create an app and set its Redirect URL to
# https://your-api-host/api/slack/oauth/callback. Never put real credentials here.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URL=https://your-api-host/api/slack/oauth/callback
# Generate with: openssl rand -hex 32
SLACK_TOKEN_ENCRYPTION_KEY=
# At least 32 random characters. Required as Bearer token for OAuth start and disconnect.
SLACK_MANAGEMENT_TOKEN=
# Local development Elasticsearch is bound to loopback by Docker Compose.
# The Compose service disables Elasticsearch security only for this local profile.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_PORT=9200
# At least 32 random characters; required to access /admin/queues.
BULL_BOARD_TOKEN=
