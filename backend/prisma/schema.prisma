generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  ENQUEUED
}

enum SlackConnectionStatus {
  ACTIVE
  REVOKED
}

enum SlackNotificationStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

enum SearchIndexStatus {
  PENDING
  PROCESSING
  INDEXED
}

model Sender {
  id        String   @id @db.VarChar(64)
  email     String   @db.VarChar(320)
  name      String?  @db.VarChar(191)
  hourlyLimit Int?   @db.UnsignedInt
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  emails    Email[]
}

model Email {
  id                  String      @id @default(cuid()) @db.VarChar(191)
  idempotencyKey      String      @unique @db.VarChar(191)
  senderId            String      @db.VarChar(64)
  recipient           String      @db.VarChar(320)
  subject             String      @db.VarChar(998)
  body                String      @db.LongText
  scheduledAt         DateTime    @db.DateTime(3)
  status              EmailStatus @default(SCHEDULED)
  bullmqJobId         String?     @unique @db.VarChar(191)
  attemptCount        Int         @default(0)
  lastError           String?     @db.Text
  smtpAcceptedAt      DateTime?   @db.DateTime(3)
  smtpMessageId       String?     @db.VarChar(998)
  processingStartedAt DateTime?   @db.DateTime(3)
  searchVersion       BigInt      @default(1) @db.UnsignedBigInt
  createdAt           DateTime    @default(now()) @db.DateTime(3)
  updatedAt           DateTime    @updatedAt @db.DateTime(3)
  sender              Sender      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  outbox              EmailOutbox?
  searchOutbox        EmailSearchOutbox[]

  @@index([status, scheduledAt])
  @@index([senderId, createdAt])
}

model EmailSearchOutbox {
  id            String           @id @default(cuid()) @db.VarChar(191)
  emailId       String           @db.VarChar(191)
  version       BigInt           @db.UnsignedBigInt
  status        SearchIndexStatus @default(PENDING)
  attemptCount  Int              @default(0)
  nextAttemptAt DateTime         @default(now()) @db.DateTime(3)
  leaseExpiresAt DateTime?       @db.DateTime(3)
  lastError     String?          @db.VarChar(500)
  indexedAt     DateTime?        @db.DateTime(3)
  createdAt     DateTime         @default(now()) @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @db.DateTime(3)
  email         Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, version])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

model EmailOutbox {
  id           String       @id @default(cuid()) @db.VarChar(191)
  emailId      String       @unique @db.VarChar(191)
  status       OutboxStatus @default(PENDING)
  attemptCount Int          @default(0)
  lastError    String?      @db.Text
  enqueuedAt   DateTime?    @db.DateTime(3)
  createdAt    DateTime     @default(now()) @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @db.DateTime(3)
  email        Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model SlackConnection {
  deploymentKey      String               @id @default("default") @db.VarChar(64)
  workspaceId        String               @unique @db.VarChar(64)
  workspaceName      String               @db.VarChar(191)
  channelId          String               @db.VarChar(64)
  channelName        String               @db.VarChar(191)
  webhookCiphertext  String               @db.LongText
  webhookNonce       String               @db.VarChar(32)
  webhookAuthTag     String               @db.VarChar(32)
  status             SlackConnectionStatus @default(ACTIVE)
  installedAt        DateTime             @default(now()) @db.DateTime(3)
  updatedAt          DateTime             @updatedAt @db.DateTime(3)
}

model SlackNotificationOutbox {
  id              String                  @id @default(cuid()) @db.VarChar(191)
  eventKey        String                  @unique @db.Char(64)
  senderId        String                  @db.VarChar(64)
  senderEmail     String                  @db.VarChar(320)
  senderName      String?                 @db.VarChar(191)
  hourlyLimit     Int                     @db.UnsignedInt
  nextEligibleAt  DateTime?               @db.DateTime(3)
  status          SlackNotificationStatus @default(PENDING)
  attemptCount    Int                     @default(0)
  replayCount     Int                     @default(0)
  lastError       String?                 @db.Text
  deliveredAt     DateTime?               @db.DateTime(3)
  createdAt       DateTime                @default(now()) @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @db.DateTime(3)

  @@index([status, createdAt])
  @@index([senderId, createdAt])
}
